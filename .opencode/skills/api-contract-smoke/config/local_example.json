{
  "base_url": "http://localhost:8000",
  "readiness": {
    "path": "/health",
    "expect_status": 200,
    "timeout_sec": 10,
    "interval_sec": 0.5
  },
  "endpoints": [
    { "method": "GET", "path": "/health", "expect_status": 200, "required_json_fields": ["status"] },
    { "method": "GET", "path": "/version", "expect_status": 200, "required_json_fields": ["version"] },
    { "method": "GET", "path": "/subscribers", "expect_status": 200 }
  ]
}
