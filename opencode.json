{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  }
  ,
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "instructions": [
    "AGENTS.md"
  ],
  "experimental": {
    "primary_tools": ["edit", "bash"],
    "mcp_timeout": 45000
  }
  
  ,
  "mcp": {
    "repo-guard": {
      "type": "local",
      "enabled": true,
      "command": [
        "./.venv/bin/mcp",
        "run",
        "practices/practice_04/mcp/server.py"
      ],
      "environment": {
        "REPO_ROOT": "."
      }
    }
  }
  
}
