{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/itmo-agent",
  "small_model": "ollama/itmo-chat",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 1024
          }
        },
        "itmo-chat": {
          "name": "ITMO chat 4k",
          "limit": {
            "context": 4096,
            "output": 512
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant (itmo-agent)",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 4,
      "model": "ollama/itmo-agent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "local-guide-chat": {
      "description": "Read-only local repository assistant (itmo-chat)",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 4,
      "model": "ollama/itmo-chat",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
